{
  "ConnectionStrings": {
    "XmlFiscal": "Data Source=App_Data/xmlfiscal.db"
  },
  "XmlFiscal": {
    "ProductMatching": {
      "AutomaticMatchThreshold": 95,
      "ReviewThreshold": 70,
      "SameGtinMinimumDescriptionSimilarity": 0.82,
      "NoGtinMinimumDescriptionSimilarity": 0.93,
      "GtinWeight": 60,
      "DescriptionWeightWithGtin": 30,
      "NcmWeightWithGtin": 6,
      "UnitWeightWithGtin": 4,
      "DescriptionWeightWithoutGtin": 75,
      "NcmWeightWithoutGtin": 15,
      "UnitWeightWithoutGtin": 10,
      "DifferentGtinDescriptionWeight": 60,
      "DifferentGtinMaximumScore": 69,
      "MeasureConflictMaximumScore": 84,
      "CandidateLimit": 150
    },
    "Import": {
      "ParserParallelism": 4,
      "ChannelCapacity": 64,
      "MaximumFileSizeBytes": 104857600,
      "ProgressPersistenceInterval": 25,
      "ArchiveRootPath": "App_Data/xml-archive"
    },
    "XmlSecurity": {
      "MaximumCharactersInDocument": 120000000,
      "AllowNonOfficialNamespace": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
